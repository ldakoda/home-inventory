# Copy to .env and fill in real values. Never commit the real .env file.

# Required: a long random string used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Required: bcrypt hash of your login password (NOT the plaintext password).
# Generate one with: python -c "from app.security import hash_password; print(hash_password('your-password-here'))"
AUTH_PASSWORD_HASH=

SESSION_MAX_AGE_DAYS=30

# Firestore project. GOOGLE_APPLICATION_CREDENTIALS should point at a service
# account key with Firestore + Storage access (see secrets/, gitignored).
GCP_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Image storage: "local" (dev, images on disk) or "gcs" (prod, Cloud Storage bucket)
STORAGE_BACKEND=local
IMAGE_DIR=uploaded_images
GCS_BUCKET_NAME=

# Optional third-party API keys (features degrade gracefully without them)
OMDB_KEY=
TMDB_KEY=
BGG_TOKEN=
EMOJI_API_KEY=
